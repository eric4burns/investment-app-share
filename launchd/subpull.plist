<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>research/substack-nightly.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <!-- 03:30: after the X pull has finished its hour and a quarter and before
       the YouTube pull at 04:00. A handful of requests, a few seconds. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <!-- If the Mac was asleep at 03:30, run it when it next wakes; a post
       missed one night is fetched the next, since the archive is re-read. -->
  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PYTHONDIR__:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOGS__/subpull.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/subpull.log</string>
</dict>
</plist>
